import Sources from "../../components/Sources.astro";
import NextPrev from "../../components/NextPrev.astro";

const timeline = [
  { date: "Sep 2024", what: "Chang hard fork: CIP-1694 governance goes live with an interim constitution and an Interim Constitutional Committee." },
  { date: "Jan 2025", what: "Plomin hard fork (protocol v10): DReps get full voting power, including treasury withdrawals." },
  { date: "23 Feb 2025", what: "The first Cardano Constitution takes effect, ratified with about 85% DRep approval." },
  { date: "Jul–Aug 2025", what: "First on-chain budget: 39 Intersect-administered withdrawals, about ₳264M approved. Treasury money flows into audited smart contracts for the first time." },
  { date: "Dec 2025", what: "₳70M Critical Integrations budget enacted (USDCx, Pyth, Dune, LayerZero, custody)." },
  { date: "Jan 2026", what: "Constitution v2.4 enacted. Every withdrawal must now carry its own full justification." },
  { date: "Feb–Mar 2026", what: "Project Catalyst paused; stewardship moves from IOG to the Cardano Foundation (info action, 83% yes)." },
  { date: "May 2026", what: "Cardano Summit 2026 funding fails at 65.06% against a 67% bar. The summit is cancelled." },
  { date: "18 Jul 2026", what: "van Rossem hard fork (protocol v11): the first hard fork proposed, debated and ratified entirely on-chain." },
  { date: "Jul 2026", what: "DReps raise the Net Change Limit to ₳500M for Feb 2026 – Jul 2027." },
  { date: "17 Aug 2026", what: "₳120M Cardano PRIME DeFi program enacted (about 73% yes)." },
];

const sources = [
  { label: "Koios API (totals, epoch_params, proposal_list, proposal_voting_summary), queried 2026-10-07", url: "https://api.koios.rest/api/v1/totals" },
  { label: "Cardano Constitution", url: "https://cardano.org/constitution/" },
  { label: "IOG — From convention to ratification: the Cardano Constitution", url: "https://www.iog.io/news/from-convention-to-ratification-the-cardano-constitution" },
  { label: "Intersect — updated Constitution ratification outcome", url: "https://intersectmbo.org/news/updated-cardano-constitution-ratification-outcome-and-effective-date" },
  { label: "Bitcoinist — 39 proposals under the 2025 budget framework", url: "https://bitcoinist.com/cardano-39-proposals-under-new-budget-framework/" },
  { label: "Intersect — Critical Integrations progress update", url: "https://intersectmbo.org/news/critical-integrations-technical-progress-update-and-pentad-v2" },
  { label: "The Block — Cardano Summit 2026 cancelled after vote", url: "https://www.theblock.co/amp/post/403122/cardano-foundation-cancels-2026-summit-after-treasury-funding-vote-falls-just-short" },
  { label: "Yahoo Finance — DReps vote on Pogun", url: "https://finance.yahoo.com/markets/crypto/articles/cardano-news-dreps-pogun-vote-091000617.html" },
  { label: "Cexplorer — Orion Fund approved", url: "https://cexplorer.io/article/cardano-community-approves-50m-ada-for-the-draper-dragon-orion-fund" },
  { label: "CardanoCube — Cardano PRIME governance action", url: "https://www.cardanocube.com/governance/gov_actions/gov_action122wue2k65qq8gmpz795z2axt8apka6ay6xt3pwg8jxj5yfkujmtsqvlfpu7" },
  { label: "SundaeSwap treasury-contracts (README)", url: "https://github.com/SundaeSwap-finance/treasury-contracts" },
  { label: "cardano.org — smart contract tooling for the treasury", url: "https://cardano.org/news/2025-07-18-smart-contract-tooling/" },
