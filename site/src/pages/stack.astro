---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Callout from "../components/Callout.astro";
import Badge from "../components/Badge.astro";
import Sources from "../components/Sources.astro";
import NextPrev from "../components/NextPrev.astro";

const aikenCode = `use aiken/collection/list
use aiken/crypto.{VerificationKeyHash}
use cardano/transaction.{OutputReference, Transaction}

pub type Datum {
  owner: VerificationKeyHash,
}

pub type Redeemer {
  msg: ByteArray,
}

validator hello_world {
  spend(datum: Option<Datum>, redeemer: Redeemer, _own_ref: OutputReference, self: Transaction) {
    expect Some(Datum { owner }) = datum
    let must_say_hello = redeemer.msg == "Hello, World!"
    let must_be_signed = list.has(self.extra_signatories, owner)
    must_say_hello? && must_be_signed?
  }

  else(_) {
    fail
  }
}`;

const setupCode = `# 1. Toolchain (pick one installer)
curl --proto '=https' --tlsv1.2 -LsSf https://install.aiken-lang.org | sh   # installs aikup
# or: npm install -g @aiken-lang/aikup
# or: brew install aiken-lang/tap/aikup
aikup   # installs the latest aiken

# 2. New project, test, build
aiken new me/hello && cd hello
aiken check          # unit + property tests, no chain needed
aiken build          # writes plutus.json (CIP-57 blueprint)`;

const offchainCode = `// lock.ts — sketch with Mesh (see meshjs.dev for the full, current API)
import { BlockfrostProvider, MeshTxBuilder, MeshWallet,
         serializePlutusScript, deserializeAddress, mConStr0, applyCborEncoding } from "@meshsdk/core";
import blueprint from "./plutus.json";

const provider = new BlockfrostProvider(process.env.BLOCKFROST_PREVIEW_KEY!);
const wallet = new MeshWallet({ networkId: 0, fetcher: provider, submitter: provider,
  key: { type: "mnemonic", words: process.env.MNEMONIC!.split(" ") } });

const code = applyCborEncoding(blueprint.validators[0].compiledCode);
const { address: scriptAddr } = serializePlutusScript({ code, version: "V3" });
const owner = deserializeAddress(await wallet.getChangeAddress()).pubKeyHash;

const tx = new MeshTxBuilder({ fetcher: provider, submitter: provider });
await tx.txOut(scriptAddr, [{ unit: "lovelace", quantity: "10000000" }])
  .txOutInlineDatumValue(mConStr0([owner]))      // datum = { owner }
  .changeAddress(await wallet.getChangeAddress())
  .selectUtxosFrom(await wallet.getUtxos())
  .complete();                                    // exact fee is known here
console.log(await wallet.submitTx(await wallet.signTx(tx.txHex)));`;

const aiCode = `# Cardano Foundation skills for Claude Code (18 skills, docs refreshed weekly)
/plugin marketplace add cardano-foundation/cardano-dev-skills

# Mesh: MCP server, agent skills and llms.txt
# → https://meshjs.dev/ai

# Midnight docs over MCP
claude mcp add --transport http midnight https://midnight.mcp.kapa.ai`;

const sources = [
  { label: "Cardano Foundation 2025 developer survey (Aiken >75%)", url: "https://cardanofoundation.org/blog/2025-developer-ecosystem-survey-results" },
  { label: "Aiken changelog (v1.1.24, 2026-09-26)", url: "https://github.com/aiken-lang/aiken/blob/main/CHANGELOG.md" },
  { label: "Aiken Hello World", url: "https://aiken-lang.org/example--hello-world/basics" },
  { label: "Aiken Playground", url: "https://play.aiken-lang.org" },
  { label: "Intersect DevEx: smart contract languages session notes (Q1 2026)", url: "https://devex.intersectmbo.org/docs/working-group/q1-2026/sessions/13-smart-contracts-languages/session-notes" },
  { label: "IOG: Plutus Tx gets a makeover, meet Plinth", url: "https://www.iog.io/news/plutus-tx-gets-a-makeover-meet-plinth" },
  { label: "Scalus", url: "https://scalus.org" },
  { label: "HarmonicLabs pebble (formerly plu-ts)", url: "https://github.com/HarmonicLabs/plu-ts" },
  { label: "Marlowe (moved to marlowe-lang)", url: "https://marlowe-lang.org" },
  { label: "Mesh SDK", url: "https://meshjs.dev" },
  { label: "Evolution SDK (Intersect incubated)", url: "https://github.com/IntersectMBO/evolution-sdk" },
  { label: "Lucid Evolution maintenance notice", url: "https://github.com/no-witness-labs/lucid-evolution" },
  { label: "Blaze", url: "https://blaze.butane.dev" },
  { label: "npm registry (versions and dates, queried 2026-10-07)", url: "https://registry.npmjs.org/@meshsdk/core" },
  { label: "Blockfrost docs", url: "https://blockfrost.dev/start-building" },
  { label: "Koios", url: "https://koios.rest" },
  { label: "Dolos (TxPipe)", url: "https://github.com/txpipe/dolos" },
  { label: "Ogmios changelog (v7.0.0)", url: "https://github.com/CardanoSolutions/ogmios/blob/master/CHANGELOG.md" },
  { label: "Demeter.run", url: "https://demeter.run" },
  { label: "Yaci DevKit", url: "https://devkit.yaci.xyz" },
  { label: "UTxO RPC", url: "https://utxorpc.org" },
  { label: "Tx3 (TxPipe)", url: "https://docs.txpipe.io/tx3" },
  { label: "Testnet environments (Preview vs Preprod)", url: "https://docs.cardano.org/cardano-testnets/environments" },
  { label: "Official testnet faucet", url: "https://docs.cardano.org/cardano-testnets/tools/faucet" },
  { label: "SanchoNet", url: "https://sancho.network" },
  { label: "cardano-dev-skills (Cardano Foundation)", url: "https://github.com/cardano-foundation/cardano-dev-skills" },
  { label: "Mesh AI tools", url: "https://meshjs.dev/ai" },
  { label: "IOG Developer Experience Initiative (2026-05-18)", url: "https://www.iog.io/news/developer-experience-initiative" },
  { label: "Intersect DevEx FAQ (pain points)", url: "https://devex.intersectmbo.org/docs/faq" },
  { label: "Intersect DevEx developer pathway resources", url: "https://devex.intersectmbo.org/docs/working-group/sessions/q1-2026/cardano-developer-pathway/session-resources" },
  { label: "Developer portal review, issue #2008", url: "https://github.com/cardano-foundation/developer-portal/issues/2008" },
