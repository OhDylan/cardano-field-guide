---
const tabs = [
  { href: "/frontiers/defi", label: "DeFi & Bitcoin DeFi" },
  { href: "/frontiers/ai-agents", label: "AI agents" },
  { href: "/frontiers/midnight", label: "Midnight (privacy)" },
  { href: "/frontiers/governance", label: "Governance & treasury" },
  { href: "/frontiers/scaling", label: "Scaling & roadmap" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---
<nav class="tabs" aria-label="Frontiers">
  {tabs.map((t) => <a href={t.href} aria-current={path === t.href ? "page" : undefined}>{t.label}</a>)}
</nav>
<style>
  .tabs { display: flex; gap: .4rem; flex-wrap: wrap; margin: 0 0 2rem; }
  .tabs a { font-size: .86rem; padding: .35rem .75rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); text-decoration: none; background: var(--surface); }
  .tabs a:hover { border-color: var(--accent); }
  .tabs a[aria-current="page"] { background: var(--accent-soft); color: var(--accent-ink); border-color: var(--accent); }
</style>
