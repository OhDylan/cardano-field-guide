---
// Three small multiples sharing one time axis: TVL in USD, ADA price, TVL in ADA.
// One y-axis per panel (never a dual axis). Rendered client-side at real pixel
// width so text stays legible on phones; the table below is the no-JS fallback.
import data from "../data/tvl-history.json";
const points = data.points;
const fmtMonth = (m: string) => {
  const [y, mo, d] = m.split("-");
  const name = new Date(Date.UTC(+y, +mo - 1, d ? +d : 1)).toLocaleString("en-US", { month: "short", timeZone: "UTC" });
  return d ? `${name} ${+d}, ${y}` : `${name} ${y}`;
};
---
<figure class="tvl">
  <figcaption>
    <strong>Cardano DeFi TVL, three ways</strong>
    <span class="muted small">Monthly, Feb 2022 – Oct 6 2026. The top panel is roughly the middle panel × the bottom one; hover or tap to compare a month.</span>
  </figcaption>
  <div class="tvl-chart" data-tvl-chart aria-hidden="true"></div>
  <div class="tvl-tip" role="status" aria-live="polite" hidden></div>
  <details class="tvl-table">
    <summary>Show as a table</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Month</th><th class="num">TVL (USD)</th><th class="num">ADA price</th><th class="num">TVL (ADA)</th></tr></thead>
        <tbody>
          {points.map((p) => (
            <tr><td>{fmtMonth(p.m)}</td><td class="num">${p.usd}M</td><td class="num">${p.price.toFixed(3)}</td><td class="num">{p.ada}M ADA</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <p class="stamp">{data.source}</p>
  <script type="application/json" data-tvl-json set:html={JSON.stringify(points)} />
</figure>

<style>
  .tvl { margin: 1.5rem 0 2rem; padding: 1rem 1rem .8rem; background: var(--chart-surface); border: 1px solid var(--line); border-radius: var(--radius); position: relative; }
  figcaption { display: grid; gap: .2rem; margin-bottom: .6rem; }
  .tvl-chart { width: 100%; min-height: 420px; }
  .tvl-chart :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .tvl-chart :global(.grid) { stroke: var(--chart-grid); stroke-width: 1; }
  .tvl-chart :global(.base) { stroke: var(--chart-axis); stroke-width: 1; }
  .tvl-chart :global(.tick) { fill: var(--muted); font: 11px var(--font-sans); font-variant-numeric: tabular-nums; }
  .tvl-chart :global(.ptitle) { fill: var(--ink); font: 600 12.5px var(--font-sans); }
  .tvl-chart :global(.note) { fill: var(--ink-2); font: 11.5px var(--font-sans); }
  .tvl-chart :global(.line) { fill: none; stroke: var(--series-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .tvl-chart :global(.area) { fill: var(--series-1); opacity: .1; }
  .tvl-chart :global(.dot) { fill: var(--series-1); stroke: var(--chart-surface); stroke-width: 2; }
  .tvl-chart :global(.band) { fill: var(--gap); opacity: .08; }
  .tvl-chart :global(.band-edge) { stroke: var(--gap); stroke-width: 1; opacity: .5; }
  .tvl-chart :global(.cross) { stroke: var(--ink-2); stroke-width: 1; }
  .tvl-tip { position: absolute; pointer-events: none; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; padding: .5rem .7rem; font-size: .8rem; line-height: 1.45; box-shadow: 0 4px 14px rgba(0,0,0,.12); min-width: 160px; z-index: 2; }
  .tvl-tip :global(b) { display: block; margin-bottom: .15rem; }
  .tvl-tip :global(.row) { display: flex; justify-content: space-between; gap: 1rem; font-variant-numeric: tabular-nums; }
  .tvl-tip :global(.k) { color: var(--ink-2); }
  .tvl-table { margin-top: .6rem; font-size: .88rem; }
  .tvl-table summary { cursor: pointer; color: var(--accent-ink); }
  .tvl-table .table-wrap { max-height: 320px; overflow: auto; margin-top: .6rem; }
  .stamp { margin: .6rem 0 0; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tvl-chart]");
  const json = document.querySelector("[data-tvl-json]");
  const tip = document.querySelector<HTMLElement>(".tvl-tip");
  if (root && json && tip) {
    type P = { m: string; usd: number; price: number; ada: number };
    const pts: P[] = JSON.parse(json.textContent || "[]");
    const toDate = (m: string) => { const [y, mo, d] = m.split("-").map(Number); return Date.UTC(y, mo - 1, d || 1); };
    const label = (m: string) => {
      const [y, mo, d] = m.split("-").map(Number);
      const n = new Date(Date.UTC(y, mo - 1, d || 1)).toLocaleString("en-US", { month: "short", timeZone: "UTC" });
      return d ? `${n} ${d}, ${y}` : `${n} ${y}`;
    };
    const panels = [
      { key: "usd" as const, title: "TVL in US dollars", max: 800, step: 200, fmt: (v: number) => `$${v}M`, end: (v: number) => `$${v}M` },
      { key: "price" as const, title: "ADA price", max: 1.2, step: 0.4, fmt: (v: number) => `$${v.toFixed(1)}`, end: (v: number) => `$${v.toFixed(2)}` },
      { key: "ada" as const, title: "TVL in ADA (what is actually locked)", max: 800, step: 200, fmt: (v: number) => `${v}M`, end: (v: number) => `${Math.round(v)}M ADA` },
    ];
    const NS = "http://www.w3.org/2000/svg";
    const el = (tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      if (text) e.textContent = text;
      return e;
    };

    function draw() {
      root!.innerHTML = "";
      const W = Math.max(300, root!.clientWidth);
      const narrow = W < 520;
      const ml = 46, mr = narrow ? 64 : 84, ph = narrow ? 110 : 130, gapTop = 30, gapBetween = 26, bottom = 24;
      const H = panels.length * (ph + gapTop) + (panels.length - 1) * gapBetween + bottom;
      const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, width: W, height: H });
      const t0 = toDate(pts[0].m), t1 = toDate(pts[pts.length - 1].m);
      const x = (m: string) => ml + ((toDate(m) - t0) / (t1 - t0)) * (W - ml - mr);
      const panelTop = (i: number) => i * (ph + gapTop + gapBetween) + gapTop;

      panels.forEach((p, i) => {
        const top = panelTop(i);
        const y = (v: number) => top + ph - (v / p.max) * ph;
        svg.appendChild(el("text", { x: 0, y: top - 12, class: "ptitle" }, p.title));
        for (let v = 0; v <= p.max + 1e-9; v += p.step) {
          const yy = y(v);
          svg.appendChild(el("line", { x1: ml, x2: W - mr, y1: yy, y2: yy, class: v === 0 ? "base" : "grid" }));
          svg.appendChild(el("text", { x: ml - 8, y: yy + 4, "text-anchor": "end", class: "tick" }, p.fmt(+v.toFixed(2))));
        }
        // shaded band: Jul 2026 → now, the real outflow (only on the ADA panel)
        if (p.key === "ada") {
          const bx = x("2026-07");
          svg.appendChild(el("rect", { x: bx, y: top, width: W - mr - bx, height: ph, class: "band" }));
          svg.appendChild(el("line", { x1: bx, x2: bx, y1: top, y2: top + ph, class: "band-edge" }));
          svg.appendChild(el("text", { x: bx - 6, y: top + 12, "text-anchor": "end", class: "note" }, narrow ? "Jul–Oct 2026: −47%" : "Jul–Oct 2026: real outflow, −47%"));
        }
        if (p.key === "usd") {
          const px = x("2024-12");
          svg.appendChild(el("text", { x: px + 8, y: y(660) + 4, class: "note" }, narrow ? "price spike" : "Dec 2024 peak = ADA at $1.08"));
        }
        const d = pts.map((q, j) => `${j ? "L" : "M"}${x(q.m).toFixed(1)},${y(q[p.key]).toFixed(1)}`).join("");
        const area = `${d}L${x(pts[pts.length - 1].m).toFixed(1)},${y(0)}L${x(pts[0].m).toFixed(1)},${y(0)}Z`;
        svg.appendChild(el("path", { d: area, class: "area" }));
        svg.appendChild(el("path", { d, class: "line" }));
        const last = pts[pts.length - 1];
        svg.appendChild(el("circle", { cx: x(last.m), cy: y(last[p.key]), r: 4, class: "dot" }));
        svg.appendChild(el("text", { x: x(last.m) + 8, y: y(last[p.key]) + 4, class: "tick" }, p.end(last[p.key])));
      });

      // x-axis years under the last panel
      const axisY = panelTop(panels.length - 1) + ph + 16;
      for (let yr = 2023; yr <= 2026; yr++) {
        const xx = x(`${yr}-01`);
        svg.appendChild(el("text", { x: xx, y: axisY, "text-anchor": "middle", class: "tick" }, String(yr)));
      }

      // hover layer: crosshair across all panels + one tooltip
      const cross = el("line", { y1: gapTop, y2: panelTop(panels.length - 1) + ph, class: "cross", visibility: "hidden" });
      svg.appendChild(cross);
      const hit = el("rect", { x: ml, y: 0, width: W - ml - mr, height: H, fill: "transparent" });
      svg.appendChild(hit);
      const show = (clientX: number) => {
        const r = svg.getBoundingClientRect();
        const px = ((clientX - r.left) / r.width) * W;
        let best = 0, bd = Infinity;
        pts.forEach((q, j) => { const dd = Math.abs(x(q.m) - px); if (dd < bd) { bd = dd; best = j; } });
        const q = pts[best];
        const cx = x(q.m);
        cross.setAttribute("x1", String(cx)); cross.setAttribute("x2", String(cx)); cross.setAttribute("visibility", "visible");
        tip!.innerHTML = `<b>${label(q.m)}</b><div class="row"><span class="k">TVL (USD)</span><span>$${q.usd}M</span></div><div class="row"><span class="k">ADA price</span><span>$${q.price.toFixed(3)}</span></div><div class="row"><span class="k">TVL (ADA)</span><span>${q.ada}M</span></div>`;
        tip!.hidden = false;
        const fig = root!.parentElement!.getBoundingClientRect();
        const left = r.left - fig.left + (cx / W) * r.width;
        const tw = tip!.offsetWidth;
        tip!.style.left = `${Math.min(Math.max(8, left + 12 + tw > fig.width ? left - tw - 12 : left + 12), fig.width - tw - 8)}px`;
        tip!.style.top = `${r.top - fig.top + 40}px`;
      };
      const hide = () => { cross.setAttribute("visibility", "hidden"); tip!.hidden = true; };
      hit.addEventListener("pointermove", (e) => show((e as PointerEvent).clientX));
      hit.addEventListener("pointerdown", (e) => show((e as PointerEvent).clientX));
      hit.addEventListener("pointerleave", hide);
      root!.appendChild(svg);
    }
    draw();
    let raf = 0;
    new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }).observe(root);
  }
</script>
